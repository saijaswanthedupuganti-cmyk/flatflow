# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# web testing
/apps/web/coverage/
/apps/web/playwright-report/
/apps/web/test-results/
/apps/web/.playwright/

# Next.js
/apps/web/.next/
/apps/web/out/

# generated build folders
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# local QA evidence and scratch captures
/apps/web/test-screenshots/
/apps/web/*-inspect.png
/apps/web/*.webm

# env files — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.check
# .env.local.example is intentionally committed (it has no real values)

# Vercel
/.vercel/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify/

# Android signing and local service backups (never commit)
/apps/android/*.keystore
/apps/android/keystore.properties
/apps/android/local.properties
/apps/android/app/google-services.json.bak*

# disposable source snapshots created by planning/audit tools
/docs/**/.snapshot/

# Binary build artifacts live outside Git; manifests stay tracked
/artifacts/**/*.apk
