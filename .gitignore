# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/playwright-report
/test-results
/.playwright

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db
Desktop.ini

# debug / local noise — never commit
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev-server.log
build-check.txt
login-inspect.png
signup-form.png
*.webm

# one-off local scripts (do not re-add)
/fix-currency.js
/fix-encoding.js
/fix-encoding2.js
/patch-expense.js
/patch-modal.js
/patch-return.js
.env.prod.check

# env files — never commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# .env.local.example is intentionally committed (it has no real values)

# vercel / netlify local
.vercel
.netlify

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch
/New folder/
/sasas/
/awesome-design-md/
/screen shot/
/member-home.html
