{
  "name": "habitiq-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "apps/web"
  ],
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@habitiq/web",
    "build": "npm run build --workspace=@habitiq/web",
    "start": "npm run start --workspace=@habitiq/web",
    "lint": "npm run lint --workspace=@habitiq/web",
    "test": "npm run test --workspace=@habitiq/web",
    "test:ui": "npm run test:ui --workspace=@habitiq/web",
    "test:headed": "npm run test:headed --workspace=@habitiq/web",
    "test:report": "npm run test:report --workspace=@habitiq/web",
    "test:auth": "npm run test:auth --workspace=@habitiq/web",
    "test:tasks": "npm run test:tasks --workspace=@habitiq/web",
    "test:expenses": "npm run test:expenses --workspace=@habitiq/web",
    "test:mobile": "npm run test:mobile --workspace=@habitiq/web"
  }
}
